# 复制为 .env.local（已被 git 忽略），填入你自己的 Key；部署时在 Vercel / Cloudflare 后台填同名环境变量。
# 只要填了 Key 的提供方才会启用；按 PROVIDER_ORDER 的顺序依次尝试，前一家限流或出错就换下一家。
PROVIDER_ORDER=agnes,zhipu,groq,gemini,deepseek

AGNES_API_KEY=
# AGNES_MODEL=agnes-2.5-flash

ZHIPU_API_KEY=
# ZHIPU_MODEL=glm-4.7-flash

GROQ_API_KEY=
GEMINI_API_KEY=

# 付费兜底：DeepSeek 只按预充值余额扣费，余额就是花费上限
DEEPSEEK_API_KEY=

# 允许调用网关的页面来源（逗号分隔；null 表示本地双击打开的 html 文件）
# ALLOWED_ORIGINS=https://maplecity1314.github.io,http://127.0.0.1:8765,null
